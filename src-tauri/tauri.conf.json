{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Down",
  "version": "0.1.0",
  "identifier": "com.kelvinamoaba.down",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:4322",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Down",
        "width": 1180,
        "height": 780,
        "minWidth": 620,
        "minHeight": 440,
        "center": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 18, "y": 22 },
        "transparent": true,
        "dragDropEnabled": false,
        "windowEffects": { "effects": ["sidebar"], "state": "followsWindowActiveState" }
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: http://asset.localhost https:; connect-src 'self' ipc: http://ipc.localhost ws://localhost:4322",
      "assetProtocol": { "enable": true, "scope": [] }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "category": "Productivity",
    "copyright": "Kelvin Amoaba",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.png"],
    "macOS": {
      "minimumSystemVersion": "13.0",
      "signingIdentity": "Apple Development: kelvinamoaba@icloud.com (3WG52VL2R9)"
    }
  }
}
